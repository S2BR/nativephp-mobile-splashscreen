{
    "namespace": "MobileSplashscreen",

    "bridge_functions": [],

    "android": {
        "min_version": 26,
        "dependencies": {
            "implementation": [
                "com.airbnb.android:lottie-compose:6.7.1"
            ]
        }
    },

    "ios": {
        "min_version": "18.0",
        "dependencies": {
            "swift_packages": [
                {
                    "url": "https://github.com/airbnb/lottie-spm.git",
                    "version": "4.6.0",
                    "products": ["Lottie"]
                }
            ]
        }
    },

    "events": [
        "S2BR\\MobileSplashscreen\\Events\\SplashscreenCompleted",
        "S2BR\\MobileSplashscreen\\Events\\SplashscreenLoopCompleted"
    ],

    "hooks": {
        "pre_compile": "nativephp:mobile-splashscreen:pre-compile",
        "copy_assets": "nativephp:mobile-splashscreen:copy-assets"
    }
}
